# Supabase PDF storage and pgvector index
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
SUPABASE_STORAGE_BUCKET=reference-pdfs
SUPABASE_REINDEX_PDFS=false

# Database connection (DATABASE_URL takes precedence over POSTGRES_* settings)
DATABASE_URL=
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=
POSTGRES_HOST=
POSTGRES_PORT=5432

# ML model gateway
MODEL_API_KEY=
MODEL_NAME=deepseek/deepseek-v4.1-flash

# Backend callback endpoint (inside Docker Compose network)
BACKEND_EVENTS_URL=http://backend:8080/api/v1/internal/analysis/events

