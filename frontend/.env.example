# Базовый URL backend API. Пусто — запросы идут на текущий origin (в dev через vite proxy)
VITE_API_URL=http://localhost:8080
# Куда vite dev-сервер проксирует /api
VITE_PROXY_TARGET=http://localhost:8080
# true — подменять ответы API моками из src/mocks (пока на backend нет /api/v1/news)
VITE_API_MOCKS=false
