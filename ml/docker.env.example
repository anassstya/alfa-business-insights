# Runtime overrides. Copy to ml/docker.example and fill local values.
# Existing MODEL_API_KEY and POSTGRES_* are read separately from the root .env.
TAVILY_API=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
ML_SERVICE_TOKEN=
ML_PORT=8001
ML_FIXTURE_MODE=false
ML_CALLBACK_ENABLED=false
ML_CALLBACK_URL=http://backend:8080/api/v1/internal/analysis/events
# Set this to the backend's shared callback secret before enabling callbacks.
ML_CALLBACK_TOKEN=

# No direct analysis_jobs permissions needed in backend mode.
ML_CHAT_RESULT_SOURCE=backend
ML_BACKEND_URL=http://backend:8080
ML_BACKEND_TOKEN=
