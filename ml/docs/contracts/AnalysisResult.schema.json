          "title": "Payments",
          "type": "object"
        },
        "person_links": {
          "additionalProperties": true,
          "title": "Person Links",
          "type": "object"
        },
        "data_quality": {
          "additionalProperties": true,
          "title": "Data Quality",
          "type": "object"
        }
      },
