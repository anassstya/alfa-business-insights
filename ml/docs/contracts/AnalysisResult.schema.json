  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "1.0",
      "default": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "job_id": {
      "format": "uuid",
      "title": "Job Id",
      "type": "string"
    },
    "run_id": {
      "format": "uuid",
      "title": "Run Id",
      "type": "string"
    },
    "company_id": {
      "maxLength": 128,
      "pattern": "^U_[A-Za-z0-9_]+$",
      "title": "Company Id",
      "type": "string"
    },
    "company_row_id": {
      "exclusiveMinimum": 0,
      "title": "Company Row Id",
      "type": "integer"
    },
    "role": {
      "enum": [
        "accountant",
        "ceo",
        "cfo",
        "decision_maker",
        "other_c_level",
        "owner",
        "treasurer"
      ],
      "title": "Role",
      "type": "string"
    },
    "goal": {
      "anyOf": [
        {
          "maxLength": 1000,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Goal"
    },
    "as_of": {
      "format": "date-time",
      "title": "As Of",
      "type": "string"
    },
    "mode": {
      "default": "live",
      "enum": [
        "fixture",
        "live"
      ],
      "title": "Mode",
      "type": "string"
    },
    "outcome": {
      "enum": [
        "ok",
        "partial",
        "no_relevant_evidence",
        "failed"
      ],
      "title": "Outcome",
      "type": "string"
    },
    "insights": {
      "items": {
        "$ref": "#/$defs/Insight"
