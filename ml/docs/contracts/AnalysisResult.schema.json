            "available",
            "unavailable"
          ],
          "title": "Status",
          "type": "string"
        },
        "text": {
          "anyOf": [
            {
              "maxLength": 2000,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Text"
        },
        "report_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Report At"
        },
        "evidence_refs": {
          "items": {
            "type": "string"
          },
          "maxItems": 12,
          "title": "Evidence Refs",
          "type": "array"
        }
      },
      "title": "BankView",
      "type": "object"
    },
    "BaseCompanyProfile": {
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": "1.0",
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "company_id": {
          "maxLength": 128,
          "pattern": "^U_[A-Za-z0-9_]+$",
          "title": "Company Id",
          "type": "string"
        },
        "base_information": {
          "$ref": "#/$defs/BaseInformation"
        },
        "source": {
          "enum": [
            "json",
            "supabase"
          ],
          "title": "Source",
          "type": "string"
        },
        "source_updated_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
