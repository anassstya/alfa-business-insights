          "title": "Source Updated At"
        },
        "profile_hash": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Profile Hash",
          "type": "string"
        },
        "warnings": {
          "items": {
            "type": "string"
          },
          "maxItems": 30,
          "title": "Warnings",
          "type": "array"
