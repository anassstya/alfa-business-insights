    "CompanyResearchContext": {
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": "1.0",
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "company_id": {
          "maxLength": 128,
          "pattern": "^U_[A-Za-z0-9_]+$",
          "title": "Company Id",
          "type": "string"
        },
        "profile_hash": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Profile Hash",
          "type": "string"
        },
        "as_of": {
          "format": "date-time",
          "title": "As Of",
          "type": "string"
        },
        "window": {
          "$ref": "#/$defs/ResearchWindow"
        },
        "exposures": {
          "items": {
            "$ref": "#/$defs/Exposure"
          },
          "maxItems": 50,
          "title": "Exposures",
          "type": "array"
        },
        "tasks": {
          "items": {
            "$ref": "#/$defs/SearchTask"
          },
          "maxItems": 6,
          "title": "Tasks",
          "type": "array"
        },
        "evidence": {
          "items": {
            "$ref": "#/$defs/EvidenceRecord"
          },
          "maxItems": 48,
          "title": "Evidence",
          "type": "array"
        },
        "coverage": {
          "additionalProperties": true,
          "title": "Coverage",
          "type": "object"
        },
        "gaps": {
          "items": {
            "type": "string"
          },
          "maxItems": 30,
          "title": "Gaps",
          "type": "array"
        },
        "versions": {
          "additionalProperties": {
            "type": "string"
          },
          "title": "Versions",
          "type": "object"
        },
        "trace": {
          "items": {
            "$ref": "#/$defs/StageEvent"
          },
          "maxItems": 100,
          "title": "Trace",
          "type": "array"
        },
        "expires_at": {
          "anyOf": [
            {
              "format": "date-time",
