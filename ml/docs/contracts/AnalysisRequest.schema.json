{
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "1.0",
      "default": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "job_id": {
      "format": "uuid",
      "title": "Job Id",
      "type": "string"
    },
    "company_row_id": {
      "exclusiveMinimum": 0,
      "title": "Company Row Id",
      "type": "integer"
    },
    "company_id": {
      "maxLength": 128,
      "pattern": "^U_[A-Za-z0-9_]+$",
      "title": "Company Id",
      "type": "string"
    },
    "role": {
      "enum": [
        "accountant",
        "ceo",
        "cfo",
        "decision_maker",
        "other_c_level",
        "owner",
        "treasurer"
      ],
      "title": "Role",
      "type": "string"
    },
    "goal": {
      "anyOf": [
        {
          "maxLength": 1000,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Goal"
    },
    "as_of": {
      "format": "date-time",
      "title": "As Of",
      "type": "string"
    },
    "lookback_days": {
      "default": 30,
      "maximum": 365,
      "minimum": 1,
      "title": "Lookback Days",
      "type": "integer"
    },
    "max_insights": {
      "default": 5,
      "maximum": 5,
      "minimum": 0,
      "title": "Max Insights",
      "type": "integer"
    }
  },
  "required": [
    "job_id",
    "company_row_id",
    "company_id",
    "role",
    "as_of"
  ],
  "title": "AnalysisRequest",
  "type": "object"
}
