{
  "$defs": {
    "EvidenceRecord": {
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": "1.0",
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "evidence_id": {
          "maxLength": 80,
          "title": "Evidence Id",
          "type": "string"
        },
        "document_id": {
          "maxLength": 80,
          "title": "Document Id",
          "type": "string"
        },
        "source_kind": {
          "enum": [
            "news",
            "official_release",
            "bank_research",
            "fixture"
          ],
          "title": "Source Kind",
          "type": "string"
        },
        "title": {
          "maxLength": 500,
          "title": "Title",
          "type": "string"
        },
        "publisher": {
          "anyOf": [
            {
              "maxLength": 200,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Publisher"
        },
        "url": {
          "anyOf": [
            {
              "maxLength": 2048,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Url"
        },
        "published_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Published At"
        },
        "retrieved_at": {
          "format": "date-time",
          "title": "Retrieved At",
          "type": "string"
        },
        "event_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Event At"
        },
        "excerpt": {
          "maxLength": 4000,
          "title": "Excerpt",
          "type": "string"
        },
        "content_hash": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Content Hash",
          "type": "string"
        },
        "page_number": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Page Number"
        },
        "date_status": {
          "enum": [
            "known",
            "unknown",
            "archived"
          ],
          "title": "Date Status",
          "type": "string"
        },
        "content_status": {
          "enum": [
            "full_text",
            "excerpt_only",
            "fetch_failed"
          ],
          "title": "Content Status",
          "type": "string"
        }
      },
      "required": [
        "evidence_id",
        "document_id",
        "source_kind",
        "title",
        "retrieved_at",
        "excerpt",
        "content_hash",
        "date_status",
        "content_status"
      ],
      "title": "EvidenceRecord",
      "type": "object"
    },
    "Exposure": {
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": "1.0",
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "exposure_id": {
          "maxLength": 80,
          "title": "Exposure Id",
          "type": "string"
        },
        "factor": {
          "maxLength": 160,
          "title": "Factor",
          "type": "string"
        },
        "feature_refs": {
          "items": {
            "type": "string"
          },
          "maxItems": 20,
          "title": "Feature Refs",
          "type": "array"
        },
        "observed_values": {
          "additionalProperties": true,
          "title": "Observed Values",
          "type": "object"
        },
        "rule_id": {
          "maxLength": 80,
          "title": "Rule Id",
          "type": "string"
        },
        "rule_version": {
          "maxLength": 40,
          "title": "Rule Version",
          "type": "string"
        },
        "reason": {
          "maxLength": 1200,
          "title": "Reason",
          "type": "string"
        },
        "assumptions": {
          "items": {
            "type": "string"
          },
          "maxItems": 20,
          "title": "Assumptions",
          "type": "array"
        },
        "missing_fields": {
          "items": {
            "type": "string"
          },
          "maxItems": 20,
          "title": "Missing Fields",
          "type": "array"
        },
        "priority": {
          "maximum": 100,
          "minimum": 0,
          "title": "Priority",
          "type": "integer"
        }
      },
      "required": [
        "exposure_id",
        "factor",
        "feature_refs",
        "rule_id",
        "rule_version",
        "reason",
        "priority"
      ],
      "title": "Exposure",
      "type": "object"
    },
    "ResearchWindow": {
      "additionalProperties": false,
      "properties": {
        "start": {
          "format": "date-time",
          "title": "Start",
          "type": "string"
        },
        "end": {
          "format": "date-time",
          "title": "End",
          "type": "string"
        }
      },
      "required": [
        "start",
        "end"
      ],
      "title": "ResearchWindow",
      "type": "object"
    },
    "SearchTask": {
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": "1.0",
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "task_id": {
          "maxLength": 80,
          "title": "Task Id",
          "type": "string"
        },
        "exposure_ids": {
          "items": {
            "type": "string"
          },
          "maxItems": 20,
          "title": "Exposure Ids",
          "type": "array"
        },
        "question": {
          "maxLength": 500,
          "title": "Question",
          "type": "string"
        },
        "query": {
          "maxLength": 300,
          "title": "Query",
          "type": "string"
        },
        "source_kind": {
          "enum": [
            "news",
            "official_release",
            "bank_research",
            "fixture"
          ],
          "title": "Source Kind",
          "type": "string"
        },
        "filters": {
          "additionalProperties": true,
          "title": "Filters",
          "type": "object"
        },
        "priority": {
          "maximum": 100,
          "minimum": 0,
          "title": "Priority",
          "type": "integer"
        },
        "reason": {
          "maxLength": 700,
          "title": "Reason",
          "type": "string"
        },
        "expected_evidence": {
          "maxLength": 700,
          "title": "Expected Evidence",
          "type": "string"
        },
        "max_results": {
          "maximum": 8,
          "minimum": 1,
          "title": "Max Results",
          "type": "integer"
        }
      },
      "required": [
        "task_id",
        "exposure_ids",
        "question",
        "query",
        "source_kind",
        "priority",
        "reason",
        "expected_evidence",
        "max_results"
      ],
      "title": "SearchTask",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "1.0",
      "default": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "company_id": {
      "maxLength": 128,
      "pattern": "^U_[A-Za-z0-9_]+$",
      "title": "Company Id",
      "type": "string"
    },
    "profile_hash": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Profile Hash",
      "type": "string"
    },
    "as_of": {
      "format": "date-time",
      "title": "As Of",
      "type": "string"
    },
    "window": {
      "$ref": "#/$defs/ResearchWindow"
    },
    "exposures": {
      "items": {
        "$ref": "#/$defs/Exposure"
      },
      "maxItems": 50,
      "title": "Exposures",
      "type": "array"
    },
    "tasks": {
      "items": {
        "$ref": "#/$defs/SearchTask"
      },
      "maxItems": 6,
      "title": "Tasks",
      "type": "array"
    },
    "evidence": {
      "items": {
        "$ref": "#/$defs/EvidenceRecord"
      },
      "maxItems": 48,
      "title": "Evidence",
      "type": "array"
    },
    "coverage": {
      "additionalProperties": true,
      "title": "Coverage",
      "type": "object"
    },
    "gaps": {
      "items": {
        "type": "string"
      },
      "maxItems": 30,
      "title": "Gaps",
      "type": "array"
    },
    "versions": {
      "additionalProperties": {
        "type": "string"
      },
      "title": "Versions",
      "type": "object"
    },
    "expires_at": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Expires At"
    }
  },
  "required": [
    "company_id",
    "profile_hash",
    "as_of",
    "window"
  ],
  "title": "CompanyResearchContext",
  "type": "object"
}
