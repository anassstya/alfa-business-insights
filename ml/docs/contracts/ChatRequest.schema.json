{
  "$defs": {
    "ChatTurn": {
      "additionalProperties": false,
      "properties": {
        "role": {
          "enum": [
            "user",
            "assistant"
          ],
          "title": "Role",
          "type": "string"
        },
        "content": {
          "maxLength": 8000,
          "minLength": 1,
          "title": "Content",
          "type": "string"
        },
        "id": {
          "anyOf": [
            {
              "format": "uuid",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Id"
        },
        "created_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Created At"
        }
      },
      "required": [
        "role",
        "content"
      ],
      "title": "ChatTurn",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "job_id": {
      "format": "uuid",
      "title": "Job Id",
      "type": "string"
    },
    "message": {
      "maxLength": 4000,
      "minLength": 1,
      "title": "Message",
      "type": "string"
    },
    "history": {
      "items": {
        "$ref": "#/$defs/ChatTurn"
      },
      "maxItems": 12,
      "title": "History",
      "type": "array"
    }
  },
  "required": [
    "job_id",
    "message"
  ],
  "title": "ChatRequest",
  "type": "object"
}
