# Copy entries into the existing ROOT .env for the full Docker stack.
# Shared secrets must have the same values on backend and ML.
DATABASE_URL=
ML_SERVICE_URL=http://ml:8000
# ML_MODE is not used by the current code and can be omitted.

POSTGRES_HOST=
POSTGRES_PORT=6543
POSTGRES_CONNECTION_MODE=transaction
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=
MODEL_API_KEY=
# Shared hackathon Tavily key is intentionally published at the owner's request.
TAVILY_API=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
# Set the two values agreed with backend; never generate different ones per side.
ML_SERVICE_TOKEN=
ML_CALLBACK_TOKEN=
# Enable after backend is reachable to receive progress events.
# Docker sends analysis events by default. Disable only for standalone diagnostics:
# ML_CALLBACK_ENABLED=false
ML_CALLBACK_URL=http://backend:8080/api/v1/internal/analysis/events
# Port 8001, live analysis and Supabase chat are defaults; no extra vars needed.
