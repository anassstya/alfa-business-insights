# Put these in the existing root .env or the process environment. No secrets here.
POSTGRES_HOST=
POSTGRES_PORT=
POSTGRES_CONNECTION_MODE=direct
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=
POSTGRES_SSLMODE=require
POSTGRES_CONNECT_TIMEOUT=5

# Planned for iteration 4: Tavily Search API, separate from the LLM gateway.
# Put your existing Tavily API key here; sent as Authorization: Bearer <key>.
TAVILY_API=

# Internal ML fixture service. Set true explicitly for this milestone.
ML_FIXTURE_MODE=false
# Shared secret for trusted backend -> ML requests. Never commit a value.
ML_SERVICE_TOKEN=
# Only permits unauthenticated requests from loopback when explicitly enabled.
ML_LOCAL_DEV_MODE=false
