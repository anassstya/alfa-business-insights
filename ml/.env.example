# Put these in the existing root .env or the process environment. No secrets here.
POSTGRES_HOST=
# Supabase shared transaction pooler; copy the host/user from the Connect dialog.
POSTGRES_PORT=6543
POSTGRES_CONNECTION_MODE=transaction
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=
POSTGRES_SSLMODE=require
POSTGRES_CONNECT_TIMEOUT=5

# Planned for iteration 4: Tavily Search API, separate from the LLM gateway.
# Put your existing Tavily API key here; sent as Authorization: Bearer <key>.
TAVILY_API=

# Internal ML fixture service. Set true explicitly for this milestone.
ML_FIXTURE_MODE=false
# Shared secret for trusted backend -> ML requests. Never commit a value.
ML_SERVICE_TOKEN=
# Only permits unauthenticated requests from loopback when explicitly enabled.
ML_LOCAL_DEV_MODE=false

# ML publishes events; only the backend writes analysis_jobs.result.
# Enable after the backend creates jobs and its callback is reachable.
ML_CALLBACK_ENABLED=false
ML_CALLBACK_URL=http://127.0.0.1:8080/api/v1/internal/analysis/events
# Must match ML_CALLBACK_TOKEN on the backend; distinct from ML_SERVICE_TOKEN.
ML_CALLBACK_TOKEN=
ML_CALLBACK_TIMEOUT=5
# Optional gateway timeout per call, within the overall analysis deadline.
ML_MODEL_TIMEOUT=60

# Chat reads completed analysis_jobs with SELECT only. No message/job writes.
ML_CHAT_RESULT_SOURCE=supabase
ML_BACKEND_URL=http://127.0.0.1:8080
# Optional, only if the backend protects its job GET endpoint.
ML_BACKEND_TOKEN=
